# Copy to api/.env. Never commit .env.

# dev = sign in with just a name (local only). supabase = real accounts.
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SUPABASE_URL=

# Local: `livekit-server --dev` gives these defaults.
# LiveKit Cloud: copy from your project's Settings > Keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

WEB_ORIGIN=http://localhost:5173
